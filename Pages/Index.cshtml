@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">Sistema de Organización de Inventario</h1>
    <p>Panel principal del sistema. Elige una opción para gestionar la información.</p>
</div>

<div class="text-center mb-4">
    <form method="post" asp-page-handler="Reiniciar" onsubmit="return confirm('¿Deseas limpiar completamente el estado actual del sistema?');">
        <button type="submit" class="btn btn-outline-danger btn-sm">Resetear sistema</button>
    </form>
    @if (!string.IsNullOrEmpty(Model.MensajeReinicio))
    {
        <div class="alert alert-warning mt-2 d-inline-block">@Model.MensajeReinicio</div>
    }
</div>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Carga inicial</h5>
                <p class="card-text">Importa un archivo de configuración para comenzar con categorías y registros.</p>
                <a href="/CargarXml" class="btn btn-primary">Abrir</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Jerarquías</h5>
                <p class="card-text">Consulta la estructura general y agrega nuevas divisiones o subcategorías.</p>
                <a href="/Categorias" class="btn btn-primary">Abrir</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Registros</h5>
                <p class="card-text">Agrega, busca y elimina elementos según su identificador.</p>
                <a href="/Libros" class="btn btn-primary">Abrir</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Visualización</h5>
                <p class="card-text">Genera gráficos de la estructura o del conjunto seleccionado.</p>
                <a href="/VerCategoriaGrafica" class="btn btn-primary">Abrir</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Ayuda</h5>
                <p class="card-text">Consulta la información del sistema y los datos del responsable.</p>
                <a href="/Ayuda" class="btn btn-secondary">Abrir</a>
            </div>
        </div>
    </div>
</div>